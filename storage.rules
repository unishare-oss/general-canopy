rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // A registered admin — mirrors the admins/{uid}.isAdmin check used in
    // firestore.rules for sapling/discovery creation.
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isAdmin == true;
    }

    // Uploaded object must be an image under a sane size cap (5 MiB).
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Sapling photos: readable by any signed-in user (incl. guests viewing the
    // map); writable only by admins, who create saplings.
    match /saplings/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isValidImage();
    }

    // Discovery photos: same policy as saplings.
    match /discoveries/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin() && isValidImage();
    }

    // Default deny — nothing else is readable or writable.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
